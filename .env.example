# Local development — copy to .env and fill in values
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/portfolio_tracker
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FINNHUB_API_KEY=replace-with-your-finnhub-api-key
TWELVE_DATA_API_KEY=replace-with-your-twelve-data-api-key
# Agent runtime: real Anthropic Messages API contract. Defaults to the real Anthropic
# API (ANTHROPIC_BASE_URL optional, defaults to https://api.anthropic.com). Can be
# pointed at DeepSeek's Anthropic-compatible endpoint instead for cheaper inference --
# same mechanics, different backend -- by setting ANTHROPIC_BASE_URL explicitly.
ANTHROPIC_API_KEY=replace-with-your-api-key
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
